<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ritmo_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ritmo_App"
    xmlns:ctrl="using:Ritmo_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock x:Uid="SetTitle" Text="Ajustes" FontSize="28" FontWeight="SemiBold" />

            <!-- Pomodoro -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pomodoro" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ContentControl x:Name="PomodoroHelp" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <NumberBox x:Name="FocusBox" x:Uid="SetFocusMin" Grid.Row="0" Grid.Column="0" Header="Concentración (min)"
                                   Minimum="1" Maximum="180" SmallChange="5" SpinButtonPlacementMode="Inline" />
                        <NumberBox x:Name="ShortBox" x:Uid="SetShortMin" Grid.Row="0" Grid.Column="1" Header="Descanso corto (min)"
                                   Minimum="0" Maximum="60" SmallChange="1" SpinButtonPlacementMode="Inline" />
                        <NumberBox x:Name="LongBox" x:Uid="SetLongMin" Grid.Row="1" Grid.Column="0" Header="Descanso largo (min)"
                                   Minimum="0" Maximum="120" SmallChange="5" SpinButtonPlacementMode="Inline" />
                        <NumberBox x:Name="CyclesBox" x:Uid="SetCycles" Grid.Row="1" Grid.Column="1" Header="Focos por descanso largo"
                                   Minimum="1" Maximum="12" SmallChange="1" SpinButtonPlacementMode="Inline" />
                    </Grid>
                    <TextBlock x:Uid="SetPomodoroHelp" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                               Text="Estos valores son el ritmo «Por defecto de la app». Crea ritmos con nombre para reutilizarlos al configurar cada entorno." />

                    <!-- Ritmos propios (#96) -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Uid="SetMyRhythms" Text="Mis ritmos" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ContentControl x:Name="RhythmsHelp" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="AddRhythmBtn" Click="AddRhythmBtn_Click" HorizontalAlignment="Right"
                                AutomationProperties.Name="Nuevo ritmo">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock x:Uid="SetNewRhythm" Text="Nuevo ritmo" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <StackPanel x:Name="RhythmsList" Spacing="6" />
                    <TextBlock x:Name="RhythmsEmpty" x:Uid="SetNoRhythms" Opacity="0.6" FontSize="12" Visibility="Collapsed"
                               Text="Aún no has creado ritmos propios. Usa «Nuevo ritmo» para añadir uno." />
                </StackPanel>
            </Border>

            <!-- Rango horario -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="SetSchedule" Text="Horario" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Uid="SetScheduleDesc" Text="Rango de horas que se muestra en la cuadrícula." Opacity="0.7" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <ctrl:TimeOfDayPicker x:Name="DayStartPicker" x:Uid="SetFrom" Header="Desde" MinuteStep="30" Width="120" />
                        <ctrl:TimeOfDayPicker x:Name="DayEndPicker" x:Uid="SetTo" Header="Hasta" MinuteStep="30" Width="120" />
                    </StackPanel>
                    <ComboBox x:Name="GranularityBox" x:Uid="SetGranularity" Header="Granularidad de la rejilla" Width="240">
                        <ComboBoxItem x:Uid="SetGran60" Content="1 hora" Tag="60" />
                        <ComboBoxItem x:Uid="SetGran30" Content="30 minutos" Tag="30" />
                        <ComboBoxItem x:Uid="SetGran15" Content="15 minutos" Tag="15" />
                    </ComboBox>
                    <TextBlock x:Uid="SetGranularityNote" Text="Solo cambia las líneas-guía de fondo. Los bloques se siguen colocando por su hora real (p. ej. 16:40)."
                               Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="DayPreviewToggle" x:Uid="SetDayPreview" Header="Vista previa del día al iniciar concentración"
                                  OnContent="Sí" OffContent="No" Margin="0,4,0,0" />
                    <TextBlock x:Uid="SetDayPreviewNote" Text="Al pulsar «Iniciar» en el temporizador, muestra un resumen de los bloques de hoy antes de concentrarte."
                               Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    <ComboBox x:Name="DefaultPreAlertBox" x:Uid="SetDefaultPreAlert" Header="Aviso previo por defecto" Width="240" Margin="0,4,0,0">
                        <ComboBoxItem x:Uid="SetPreAlertNone" Content="Ninguno" Tag="0" />
                        <ComboBoxItem x:Uid="SetPreAlert1" Content="1 minuto antes" Tag="1" />
                        <ComboBoxItem x:Uid="SetPreAlert5" Content="5 minutos antes" Tag="5" />
                        <ComboBoxItem x:Uid="SetPreAlert10" Content="10 minutos antes" Tag="10" />
                        <ComboBoxItem x:Uid="SetPreAlert15" Content="15 minutos antes" Tag="15" />
                        <ComboBoxItem x:Uid="SetPreAlert30" Content="30 minutos antes" Tag="30" />
                        <ComboBoxItem x:Uid="SetPreAlert60" Content="1 hora antes" Tag="60" />
                        <ComboBoxItem x:Uid="SetPreAlert120" Content="2 horas antes" Tag="120" />
                    </ComboBox>
                    <TextBlock x:Uid="SetPreAlertNote" Text="Con qué aviso se pre-rellena una sesión nueva. No cambia las sesiones ya creadas."
                               Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Categorías de bloque configurables (#83): nombre, color, si es de concentración -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Uid="SetCategories" Text="Categorías" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ContentControl x:Name="CategoriesHelp" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="AddCategoryBtn" x:Uid="SetAddCategory" Content="Añadir categoría" HorizontalAlignment="Right"
                                Click="AddCategoryBtn_Click" />
                    </Grid>
                    <TextBlock x:Uid="SetCategoriesDesc" Text="Define tus categorías de bloque: su nombre, su color en la rejilla del horario y si al empezar disparan el modo concentración."
                               Opacity="0.7" FontSize="13" TextWrapping="Wrap" />
                    <StackPanel x:Name="ColorsHost" Spacing="6" />
                </StackPanel>
            </Border>

            <!-- Modo descanso (#135): pausa los avisos (manual + periodos programados) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Uid="SetRest" Text="Descanso" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ContentControl x:Name="RestHelp" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Uid="SetRestDesc" Text="Pausa los avisos del horario. Útil para vacaciones o pausas: el horario se sigue viendo, pero no suenan avisos."
                               Opacity="0.7" FontSize="13" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="RestToggle" x:Uid="SetRestNow" Header="Modo descanso (ahora)"
                                  OffContent="No" OnContent="Sí" Toggled="RestToggle_Toggled" />

                    <Grid Margin="0,4,0,0">
                        <TextBlock x:Uid="SetScheduledPeriods" Text="Periodos programados" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="AddRestPeriodBtn" x:Uid="SetAddPeriod" Content="Añadir periodo" HorizontalAlignment="Right"
                                Click="AddRestPeriodBtn_Click" />
                    </Grid>
                    <StackPanel x:Name="RestPeriodsHost" Spacing="6" />
                    <TextBlock x:Name="RestPeriodsEmpty" x:Uid="SetNoPeriods" Text="No hay periodos de descanso programados."
                               Opacity="0.6" FontSize="13" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Conexiones (#123): se DESCUBREN/añaden en el modal; aquí se VEN y GESTIONAN
                 directamente las que ya están creadas (estilo conectores de Claude). -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Uid="SetConnections" Text="Conexiones" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Uid="SetConnectionsDesc" Text="Apps externas conectadas a Ritmo. Añade nuevas desde «Añadir conexión»."
                                       Opacity="0.7" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Uid="SetAddConnection" Grid.Column="1" Content="Añadir conexión" Click="ConnectionsBtn_Click"
                                VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock x:Name="NoConnectionsText" x:Uid="SetNoConnections" Visibility="Collapsed" Opacity="0.6" FontSize="13" TextWrapping="Wrap"
                               Text="Aún no has conectado ninguna app. Pulsa «Añadir conexión» para empezar." />

                    <!-- Gestión de la conexión ntfy (solo visible si está creada) -->
                    <Border x:Name="NtfyManageCard" Visibility="Collapsed"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="SetNtfyTitle" Text="📱  Notificaciones al móvil (ntfy)" FontWeight="SemiBold" FontSize="15" />
                            <ToggleSwitch x:Name="NtfyEnabledToggle" x:Uid="SetNtfyEnabled" Header="Enviar avisos al móvil"
                                          OnContent="Activado" OffContent="Pausado" />
                            <TextBox x:Name="NtfyServerBox" x:Uid="SetNtfyServer" Header="Servidor" PlaceholderText="https://ntfy.sh" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NtfyTopicBox" Grid.Column="0" Header="Topic" />
                                <Button x:Name="NtfyGenBtn" x:Uid="SetNtfyGen" Grid.Column="1" Content="Generar" Click="NtfyGenBtn_Click"
                                        VerticalAlignment="Bottom" ToolTipService.ToolTip="Generar un topic aleatorio" />
                                <Button x:Name="NtfyCopyBtn" x:Uid="SetNtfyCopy" Grid.Column="2" Content="Copiar" Click="NtfyCopyBtn_Click"
                                        VerticalAlignment="Bottom" ToolTipService.ToolTip="Copiar el topic al portapapeles" />
                            </Grid>

                            <!-- Guía visual (carrusel) de cómo suscribir el móvil al topic -->
                            <Button x:Uid="SetNtfyGuide" Click="NtfyGuideBtn_Click" HorizontalAlignment="Left"
                                    Content="📲  Cómo conectar mi móvil" />

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button x:Uid="SetNtfySave" Content="Guardar conexión" Click="NtfySaveBtn_Click" Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Name="NtfyTestBtn" x:Uid="SetNtfyTest" Content="Enviar prueba" Click="NtfyTestBtn_Click" />
                                <Button x:Uid="SetRemove" Content="Eliminar" Click="NtfyRemoveBtn_Click" />
                                <TextBlock x:Name="NtfyStatus" VerticalAlignment="Center" Opacity="0.85" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Gestión de Google Tasks (#64): el Client ID va embebido; el usuario solo conecta -->
                    <Border x:Name="GoogleManageCard"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="SetGTasksTitle" Text="✅  Google Tasks" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock x:Name="GoogleStatus" Opacity="0.8" FontSize="12" TextWrapping="Wrap" Text="No conectado." />
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="GoogleConnectBtn" x:Uid="SetConnect" Content="Conectar" Click="GoogleConnectBtn_Click"
                                        Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Name="GoogleSyncBtn" x:Uid="SetSyncNow" Content="Sincronizar ahora" Click="GoogleSyncBtn_Click"
                                        Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Name="GoogleDisconnectBtn" x:Uid="SetDisconnect" Content="Desconectar" Click="GoogleDisconnectBtn_Click"
                                        Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Uid="SetGTasksHelp" Text="Sincroniza tus bloques/tareas con tus listas de Google Tasks (en ambos sentidos). Si una tarea cambió en Google, gana Google; si no, gana lo que tengas en Ritmo."
                                       Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Publicar el horario en Google Calendar (#112 Fase 2): reúsa el OAuth de Google -->
                    <Border x:Name="GoogleCalManageCard"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="SetGCalTitle" Text="📅  Google Calendar" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock x:Name="GoogleCalStatus" Opacity="0.8" FontSize="12" TextWrapping="Wrap"
                                       Text="Publica tus sesiones en un calendario «Ritmo» de Google." />
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="GoogleCalPublishBtn" x:Uid="SetGCalPublish" Content="Publicar mi horario" Click="GoogleCalPublishBtn_Click"
                                        Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Name="GoogleCalUnpublishBtn" x:Uid="SetGCalUnpublish" Content="Despublicar" Click="GoogleCalUnpublishBtn_Click"
                                        Visibility="Collapsed" />
                                <HyperlinkButton x:Name="GoogleCalReconnectBtn" x:Uid="SetGCalReconnect" Content="Reconectar (dar permiso de Calendar)"
                                                 Click="GoogleCalReconnectBtn_Click" />
                            </StackPanel>
                            <TextBlock x:Uid="SetGCalHelp" Text="Una vía: crea/actualiza en tu Google Calendar los eventos de tus sesiones (recurrentes y extraordinarias) en un calendario propio «Ritmo». Vuelve a publicar tras cambiar el horario."
                                       Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="GoogleCalShowToggle" x:Uid="SetGCalShow" Header="Mostrar mis eventos de Google en el Horario/Hoy"
                                          OnContent="Sí" OffContent="No" Toggled="GoogleCalShowToggle_Toggled" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- Fases del plan (#46) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock x:Uid="SetPhases" Text="Fases del plan" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="AddPhaseBtn" Click="AddPhaseBtn_Click" HorizontalAlignment="Right"
                                AutomationProperties.Name="Nueva fase">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock x:Uid="SetNewPhase" Text="Nueva fase" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Uid="SetPhasesDesc" Opacity="0.7" FontSize="13" TextWrapping="Wrap"
                               Text="Cada fase tiene su propio horario y un rango de fechas (p. ej. «Fase 1», «Fase 2»). El Horario muestra la fase vigente según la fecha; puedes ver otras desde el selector del Horario." />
                    <StackPanel x:Name="PhasesList" Spacing="8" />
                </StackPanel>
            </Border>

            <!-- Entornos de concentración (#53) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock x:Uid="SetEnvironments" Text="Entornos de concentración" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button x:Name="AddEnvBtn" Click="AddEnvBtn_Click" HorizontalAlignment="Right"
                                AutomationProperties.Name="Añadir entorno">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock x:Uid="SetAddEnv" Text="Añadir entorno" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Uid="SetEnvironmentsDesc" Opacity="0.7" FontSize="13" TextWrapping="Wrap"
                               Text="Qué ocurre al concentrarte: música, apps a cerrar, No molestar… El marcado como predeterminado (★) se usa cuando un bloque no tiene un entorno propio asignado." />
                    <StackPanel x:Name="EnvList" Spacing="8" />
                    <TextBlock x:Name="EnvEmpty" x:Uid="SetEnvEmpty" Text="Aún no hay entornos. Añade uno para personalizar tu concentración."
                               Opacity="0.6" FontSize="13" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Entorno por tipo de bloque (#70) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SetEnvPerType" Text="Entorno por tipo de bloque" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Uid="SetEnvPerTypeDesc" Opacity="0.7" FontSize="13" TextWrapping="Wrap"
                               Text="Elige qué entorno usar al concentrarte en cada tipo de bloque del horario. «Por defecto» usa el entorno predeterminado (★)." />
                    <StackPanel x:Name="KindEnvList" Spacing="8" />
                    <TextBlock x:Name="KindEnvHint" x:Uid="SetKindEnvHint" Opacity="0.6" FontSize="13" TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Text="Crea al menos un entorno arriba para poder asignarlo a un tipo de bloque." />
                </StackPanel>
            </Border>

            <!-- Apps vinculadas (#107) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SetLinkedApps" Text="Apps vinculadas" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Uid="SetLinkedAppsDesc" Opacity="0.7" FontSize="13" TextWrapping="Wrap"
                               Text="Conecta servicios externos una vez aquí; luego los usas en tus entornos." />

                    <TextBlock x:Uid="SetMusicHeader" Text="MÚSICA" FontSize="11" FontWeight="SemiBold" Opacity="0.55" />
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE93C;" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="Navidrome" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavHeaderStatus" VerticalAlignment="Center" FontSize="12" Opacity="0.6" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="12" Padding="4,8,4,4">
                            <TextBlock x:Uid="SetNavidromeHelp" Opacity="0.7" FontSize="13" TextWrapping="Wrap"
                                       Text="Conecta tu servidor de Navidrome. En cada entorno solo eliges una playlist. La contraseña se guarda en el almacén seguro de Windows, nunca en la copia de seguridad." />
                            <TextBox x:Name="NavServerBox" x:Uid="SetNavServer" Header="URL del servidor" PlaceholderText="https://music.midominio.com" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NavUserBox" x:Uid="SetNavUser" Grid.Column="0" Header="Usuario" />
                                <PasswordBox x:Name="NavPassBox" x:Uid="SetNavPass" Grid.Column="1" Header="Contraseña" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="NavConnectBtn" x:Uid="SetConnect" Click="NavConnectBtn_Click" Content="Conectar" Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Name="NavDisconnectBtn" x:Uid="SetDisconnect" Click="NavDisconnectBtn_Click" Content="Desconectar" />
                                <TextBlock x:Name="NavStatus" VerticalAlignment="Center" Opacity="0.85" FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <TextBlock x:Uid="SetCalendarHeader" Text="CALENDARIO" FontSize="11" FontWeight="SemiBold" Opacity="0.55" Margin="0,4,0,0" />
                    <TextBlock Opacity="0.7" FontSize="13" TextWrapping="Wrap">
                        <Run Text="Suscríbete por enlace ICS (" />
                        <Hyperlink NavigateUri="https://calendar.google.com">Google</Hyperlink>
                        <Run Text=": «dirección secreta en formato iCal»; " />
                        <Hyperlink NavigateUri="https://outlook.live.com/calendar/">Outlook</Hyperlink>
                        <Run Text=": «publicar calendario»; " />
                        <Hyperlink NavigateUri="https://www.icloud.com/es-es/calendar">iCloud</Hyperlink>
                        <Run Text=": «calendario público»). Solo lectura: tus eventos aparecen en «Hoy»." />
                    </TextBlock>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CalNameBox" x:Uid="SetCalName" Grid.Column="0" PlaceholderText="Nombre" Width="130"
                                 AutomationProperties.Name="Nombre del calendario" />
                        <TextBox x:Name="CalUrlBox" Grid.Column="1" PlaceholderText="https://…/basic.ics"
                                 AutomationProperties.Name="Enlace ICS" />
                        <Button x:Name="CalAddBtn" x:Uid="SetCalAdd" Grid.Column="2" Click="CalAddBtn_Click" Content="Añadir"
                                AutomationProperties.Name="Agregar calendario" />
                    </Grid>
                    <StackPanel x:Name="CalFeedsList" Spacing="4" />
                </StackPanel>
            </Border>

            <!-- Actualizaciones (#124, Fase 3) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SetUpdates" Text="Actualizaciones" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Opacity="0.7" FontSize="13" />
                    <TextBlock x:Uid="SetUpdatesDesc" Text="Ritmo se actualiza solo desde GitHub (App Installer). Aquí puedes comprobarlo manualmente."
                               Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="CheckUpdateBtn" x:Uid="SetCheckUpdate" Content="Buscar actualizaciones" Click="CheckUpdateBtn_Click" />
                        <Button x:Name="InstallUpdateBtn" x:Uid="SetInstallNow" Content="Instalar ahora" Click="InstallUpdateBtn_Click"
                                Style="{ThemeResource AccentButtonStyle}" Visibility="Collapsed" />
                        <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" Opacity="0.85" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Apariencia -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="SetAppearance" Text="Apariencia" FontSize="18" FontWeight="SemiBold" />
                    <ComboBox x:Name="ThemeBox" x:Uid="SetTheme" Header="Tema" Width="240" SelectionChanged="ThemeBox_SelectionChanged">
                        <ComboBoxItem x:Uid="SetThemeSystem" Content="Según el sistema" Tag="system" />
                        <ComboBoxItem x:Uid="SetThemeLight" Content="Claro" Tag="light" />
                        <ComboBoxItem x:Uid="SetThemeDark" Content="Oscuro" Tag="dark" />
                    </ComboBox>
                    <TextBlock x:Uid="SetThemeNote" Text="«Según el sistema» usa el tema de Windows. El cambio se aplica al instante."
                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

                    <ComboBox x:Name="LanguageBox" x:Uid="SettingsLanguage" Header="Idioma" Width="240"
                              SelectionChanged="LanguageBox_SelectionChanged" Margin="0,4,0,0">
                        <ComboBoxItem x:Uid="SettingsLangSystem" Content="Según el sistema" Tag="system" />
                        <ComboBoxItem Content="Español" Tag="es" />
                        <ComboBoxItem Content="English" Tag="en" />
                    </ComboBox>
                    <TextBlock x:Name="LanguageHint" x:Uid="SettingsLanguageHint"
                               Text="El cambio de idioma se aplica al reiniciar la app."
                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Bloqueo de webs (extensión de navegador, #8) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock x:Uid="SetWebBlock" Text="Bloqueo de webs (avanzado)" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Uid="SetWebBlockDesc" TextWrapping="Wrap" Opacity="0.8" FontSize="13"
                               Text="Durante la concentración, Ritmo minimiza al instante las ventanas en webs bloqueadas del entorno. Para un bloqueo a nivel de RED (que impida cargarlas), instala la extensión de navegador. La lista de webs se configura en cada entorno." />
                    <Button x:Name="PrepareBlockerBtn" x:Uid="SetPrepareBlocker" Content="Preparar extensión de bloqueo…"
                            Click="PrepareBlockerBtn_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Notas y enlaces rápidos (#55) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock x:Uid="SetNotes" Text="Notas" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button x:Name="AddNoteBtn" Click="AddNoteBtn_Click" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock x:Uid="SetAddNote" Text="Añadir nota" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Uid="SetNotesDesc" Opacity="0.7" FontSize="13" TextWrapping="Wrap"
                               Text="Notas fijadas (admiten Markdown). Aparecen en la pantalla «Hoy». Los enlaces ahora viven en cada entorno de trabajo." />
                    <StackPanel x:Name="NotesList" Spacing="8" />
                </StackPanel>
            </Border>

            <!-- Copia de seguridad (#56) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="SetBackup" Text="Copia de seguridad" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Uid="SetBackupDesc" Opacity="0.7" FontSize="13" TextWrapping="Wrap"
                               Text="Exporta toda tu configuración (horario, fases, entornos, notas, ajustes) a un archivo, o impórtala para restaurarla. Importar reemplaza la configuración actual." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ExportBtn" Click="ExportBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                                <TextBlock x:Uid="SetExport" Text="Exportar configuración" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ImportBtn" Click="ImportBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                                <TextBlock x:Uid="SetImport" Text="Importar configuración" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="BackupStatus" VerticalAlignment="Center" Opacity="0.8" FontSize="13" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Segundo plano y arranque (#24/#20) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock x:Uid="SetBgStartup" Text="Segundo plano y arranque" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Uid="SetBgStartupDesc" Opacity="0.7" FontSize="13" TextWrapping="Wrap"
                               Text="Al cerrar la ventana, Ritmo sigue en segundo plano para que los avisos del horario suenen igualmente. Vuelve a abrirlo desde el menú Inicio o usa «Salir» para cerrarlo del todo." />
                    <ToggleSwitch x:Name="AutostartSwitch" x:Uid="SetAutostart" Header="Arrancar Ritmo al iniciar sesión en Windows"
                                  OffContent="No" OnContent="Sí" Toggled="AutostartSwitch_Toggled" />
                    <TextBlock x:Name="AutostartHint" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    <Button x:Name="ExitBtn" Click="ExitBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                            <TextBlock x:Uid="SetExit" Text="Salir de Ritmo (detiene los avisos)" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Guardar -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SaveBtn" x:Uid="SetSave" Click="SaveBtn_Click" Style="{StaticResource AccentButtonStyle}" Content="Guardar cambios" />
                <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" Opacity="0.8" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
