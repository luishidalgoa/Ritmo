<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ritmo_App.Controls.TimeOfDayPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Selector de hora propio (#150): a diferencia del TimePicker nativo, permite pintar en
         gris y bloquear los slots inválidos (hora/min que no superan el mínimo exclusivo). -->
    <StackPanel Spacing="4">
        <TextBlock x:Name="HeaderText" FontWeight="SemiBold" FontSize="13" Visibility="Collapsed" />
        <Button x:Name="Trigger" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ValueText" Grid.Column="0" Text="00:00" VerticalAlignment="Center" />
                <FontIcon Grid.Column="1" Glyph="&#xE823;" FontSize="14" Margin="8,0,0,0" />
            </Grid>
            <Button.Flyout>
                <Flyout x:Name="DropFlyout" Placement="Bottom">
                    <Flyout.FlyoutPresenterStyle>
                        <Style TargetType="FlyoutPresenter">
                            <Setter Property="Padding" Value="4" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <StackPanel Spacing="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="68" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Hora" FontSize="11" Opacity="0.6"
                                       HorizontalAlignment="Center" Margin="0,2,0,4" />
                            <TextBlock Grid.Column="1" Text="Min" FontSize="11" Opacity="0.6"
                                       HorizontalAlignment="Center" Margin="0,2,0,4" />
                        </Grid>
                        <Grid Height="200">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="68" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0" x:Name="HoursScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="HoursPanel" />
                            </ScrollViewer>
                            <ScrollViewer Grid.Column="1" x:Name="MinutesScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="MinutesPanel" />
                            </ScrollViewer>
                        </Grid>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
