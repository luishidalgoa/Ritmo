<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ritmo_App.FocusOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ritmo_App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Estilo "modo reposo (StandBy)" de iPhone: fondo negro, hora gigante de color. -->
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#0A0A0B">

        <!-- ====================== MODO NORMAL ====================== -->
        <Grid x:Name="NormalRoot" Padding="24,16,22,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Fila principal: hora grande (izquierda) + info (derecha). Es la zona de ARRASTRE. -->
            <Grid x:Name="NormalDragArea" Grid.Row="0" ColumnSpacing="18" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ClockText" Grid.Column="0" Text="00:00"
                           FontSize="100" FontWeight="Bold" LineHeight="100"
                           FontFamily="Segoe UI Variable Display"
                           Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" MinWidth="104">
                    <TextBlock x:Name="DateText" Text="" FontSize="15" FontWeight="SemiBold" Opacity="0.95" />
                    <TextBlock x:Name="PhaseLabel" Text="CONCENTRACIÓN" FontSize="11" FontWeight="SemiBold"
                               Opacity="0.5" CharacterSpacing="100" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                        <FontIcon x:Name="PomoGlyph" Glyph="&#xE916;" FontSize="13" Opacity="0.85" />
                        <TextBlock x:Name="PomoText" Text="00:00" FontSize="15" FontWeight="SemiBold" FontFamily="Consolas" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Progreso + controles -->
            <StackPanel Grid.Row="1" Spacing="10" Margin="0,12,0,0">
                <ProgressBar x:Name="Prog" Minimum="0" Maximum="1" Value="0" Height="3" />
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PauseBtn" Grid.Column="0" Click="PauseBtn_Click" Padding="12,6"
                            ToolTipService.ToolTip="Pausar / Reanudar">
                        <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="14" />
                    </Button>
                    <Button x:Name="SkipBtn" Grid.Column="1" Click="SkipBtn_Click" Padding="12,6"
                            ToolTipService.ToolTip="Saltar a la siguiente fase">
                        <FontIcon Glyph="&#xE893;" FontSize="14" />
                    </Button>
                    <Button x:Name="NotesBtn" Grid.Column="2" Click="NotesBtn_Click" Padding="12,6"
                            ToolTipService.ToolTip="Notas de la sesión activa">
                        <FontIcon Glyph="&#xE70B;" FontSize="14" />
                    </Button>
                    <Button x:Name="CompactToggleBtn" Grid.Column="3" Click="CompactToggleBtn_Click" Padding="12,6"
                            ToolTipService.ToolTip="Compactar la isla">
                        <FontIcon Glyph="&#xE73F;" FontSize="14" />
                    </Button>
                    <Button x:Name="ExpandBtn" Grid.Column="4" Click="ExpandBtn_Click" HorizontalAlignment="Right"
                            Style="{StaticResource AccentButtonStyle}" Padding="14,6"
                            ToolTipService.ToolTip="Abrir la app y cerrar esta ventana">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE740;" FontSize="14" />
                            <TextBlock Text="Abrir" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- ====================== MODO COMPACTO ====================== -->
        <Grid x:Name="CompactRoot" Padding="16,8,10,8" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Zona de arrastre del modo compacto: hora + pomodoro -->
            <StackPanel x:Name="CompactDragArea" Grid.Column="0" Orientation="Horizontal" Spacing="12"
                        VerticalAlignment="Center" Background="Transparent">
                <TextBlock x:Name="CompactClock" Text="00:00" FontSize="40" FontWeight="Bold" LineHeight="40"
                           FontFamily="Segoe UI Variable Display"
                           Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock x:Name="CompactPhase" Text="" FontSize="9" FontWeight="SemiBold"
                               Opacity="0.5" CharacterSpacing="80" />
                    <TextBlock x:Name="CompactPomo" Text="00:00" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas" />
                </StackPanel>
            </StackPanel>

            <Button x:Name="CompactNotesBtn" Grid.Column="1" Click="NotesBtn_Click" Padding="10,6"
                    VerticalAlignment="Center" ToolTipService.ToolTip="Notas de la sesión activa">
                <FontIcon Glyph="&#xE70B;" FontSize="13" />
            </Button>
            <Button x:Name="CompactPauseBtn" Grid.Column="2" Click="PauseBtn_Click" Padding="10,6"
                    VerticalAlignment="Center" ToolTipService.ToolTip="Pausar / Reanudar">
                <FontIcon x:Name="CompactPauseIcon" Glyph="&#xE769;" FontSize="13" />
            </Button>
            <Button x:Name="GrowBtn" Grid.Column="3" Click="GrowBtn_Click" Padding="10,6"
                    VerticalAlignment="Center" ToolTipService.ToolTip="Tamaño normal">
                <FontIcon Glyph="&#xE740;" FontSize="13" />
            </Button>
        </Grid>
    </Grid>
</Window>
