  <data name="AboutColPack.Text" xml:space="preserve"><value>EMPAQUETADO</value></data>
  <data name="AboutArch1.Text" xml:space="preserve"><value>Núcleo puro + xUnit</value></data>
  <data name="AboutArch2.Text" xml:space="preserve"><value>Host WinUI</value></data>
